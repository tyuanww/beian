    "hono": "^4.9.6",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
